# Vorlage für die Umgebungsvariablen. Lokal als .env kopieren, auf dem Server in Coolify eintragen.

# Postgres-Datenbank für das CMS. Lokal zum Beispiel postgres://<benutzer>@localhost:5433/tepel_cms
DATABASE_URI=

# Öffentliche Adresse der Umgebung ohne Schrägstrich am Ende, z. B. https://tepel-steuerberatung.de.
# Schützt die Redaktion vor CSRF und macht das Login-Cookie über HTTPS sicher. Lokal leer lassen.
SERVER_URL=

# Geheimer Schlüssel für Payload, je Umgebung neu erzeugen: openssl rand -hex 32
PAYLOAD_SECRET=

# Ordner für hochgeladene Bilder. Im Docker-Image ist /app/media bereits gesetzt.
PAYLOAD_MEDIA_DIR=

# Nur auf Staging: Passwortschutz in der Form benutzer:passwort. Auf der Live-Seite leer lassen.
STAGING_BASIC_AUTH=

# Versand des Kontaktformulars über Resend. Ohne Schlüssel geht keine Mail raus.
# Ist STAGING_BASIC_AUTH gesetzt, beginnt der Betreff der Anfrage an Fabian mit „[Testseite]“.
RESEND_API_KEY=
